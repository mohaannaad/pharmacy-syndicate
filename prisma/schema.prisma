// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
}

enum Role {
  MEMBER
  ADMIN
}
model News {
  id         String   @id @default(cuid())
  type       NewsType @default(ARTICLE)
  title      String
  content    String?
  imageUrl   String?
  youtubeUrl String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

enum NewsType {
  YOUTUBE
  ARTICLE
}

model Ad {
  id          String   @id @default(cuid())
  placement   AdPlacement
  duration    String
  price       Int
  title       String
  description String
  contactInfo String
  fileUrl     String?
  status      AdStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
}

enum AdPlacement {
  WEBSITE
  HQ
  BOTH
}

enum AdStatus {
  DRAFT
  UNDER_REVIEW
  NEEDS_EDIT
  APPROVED_AWAITING_PAYMENT
  PAID
  SCHEDULED
  PUBLISHED
  COMPLETED
  REJECTED
}